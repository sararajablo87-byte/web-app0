{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app0",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f0f9cae1-1427-49d8-bfde-f1567ed615ca","database_name": "D1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2e46e18a1f154f62b50228e300898f7d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
